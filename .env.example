MAILMIND_DB_PATH=data/mailmind.db
MAILMIND_GMAIL_CREDENTIALS=credentials.json
MAILMIND_GMAIL_TOKEN=token.json
MAILMIND_POLL_QUERY=newer_than:14d
MAILMIND_POLL_LIMIT=20

# Scheduler and notification jobs.
MAILMIND_SCHEDULER_ENABLED=true
MAILMIND_POLL_INTERVAL_MINUTES=15
MAILMIND_DAILY_DIGEST_ENABLED=true
MAILMIND_DAILY_DIGEST_TIME=08:00
MAILMIND_DEADLINE_REMINDERS_ENABLED=true
MAILMIND_TELEGRAM_NOTIFICATIONS_ENABLED=false

# LLM extraction. Keep mock for offline demos; switch to anthropic for real extraction.
MAILMIND_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=your_anthropic_api_key

# Required only when Telegram notifications or python -m mailmind.bot are enabled.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Optional AI search / RAG settings.
MAILMIND_RAG_ENABLED=true
MAILMIND_RAG_EMAIL_ENABLED=true
MAILMIND_RAG_PDF_ENABLED=true
MAILMIND_RAG_AUTO_INDEX=false
MAILMIND_ATTACHMENT_DIR=attachments
MAILMIND_CHROMA_DIR=chroma
MAILMIND_EMBEDDING_PROVIDER=local_bge_m3
MAILMIND_BGE_MODEL=BAAI/bge-m3
VOYAGE_API_KEY=your_voyage_api_key
MAILMIND_RAG_TOP_K=4
MAILMIND_RAG_HYBRID_ENABLED=true
MAILMIND_RAG_VECTOR_CANDIDATES=30
MAILMIND_RAG_BM25_CANDIDATES=30
MAILMIND_RAG_RERANK_ENABLED=true
MAILMIND_RAG_RERANK_MODEL=BAAI/bge-reranker-base

# PII Guard. Use off to send original text to Claude, or rehydrated to send placeholders
# to Claude and restore the final answer locally for the user.
MAILMIND_PII_ENABLED=true
MAILMIND_PII_MODE=rehydrated
MAILMIND_PII_REDACT_NAMES=true
MAILMIND_PII_PRESERVE_DATES=true
MAILMIND_PII_REDACT_LOGS=true
